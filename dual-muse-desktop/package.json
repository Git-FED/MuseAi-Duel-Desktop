{
  "name": "dual-muse-desktop",
  "version": "1.0.0",
  "description": "Unofficial Dual-Muse split-screen desktop wrapper",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^41.10.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.fedpromptly.dualmuse.desktop",
    "productName": "Dual-Muse",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": ["main.js", "index.html", "renderer.js", "package.json", "assets/**/*"],
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis", "portable"],
      "artifactName": "Dual-Muse-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": ["AppImage"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dual-Muse"
    }
  }
}
